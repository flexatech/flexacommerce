{
    "name": "flexatech/flexacommerce",
    "description": "FlexaCommerce: a commerce engine for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "php-stubs/woocommerce-stubs": "^11.2",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.0",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Flexa\\Commerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flexa\\Commerce\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:woocommerce": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv FXC_WC_STORAGE=legacy",
            "phpunit -c tests/phpunit-woocommerce.xml.dist",
            "@putenv FXC_WC_STORAGE=hpos",
            "phpunit -c tests/phpunit-woocommerce.xml.dist",
            "@putenv FXC_WC_STORAGE=sync",
            "phpunit -c tests/phpunit-woocommerce.xml.dist"
        ]
    },
    "scripts-descriptions": {
        "test:woocommerce": "Migration tests against WooCommerce, once per order storage mode (legacy, HPOS, HPOS with sync)."
    }
}
